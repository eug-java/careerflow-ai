# Optional platform fallback OpenAI key (used only when a user has not saved their own key)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional service URLs (defaults work for local docker-compose)
# AUTH_SERVICE_URL=http://localhost:8079
# PROFILE_SERVICE_URL=http://localhost:8081

# Database (auth-service)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5437/careerflow_auth

# Email (email-service)
# CAREERFLOW_EMAIL_ENCRYPTION_KEY must be exactly 32 characters
# EMAIL_DATASOURCE_URL=jdbc:postgresql://localhost:5438/careerflow_email
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=careerflow
# MINIO_SECRET_KEY=careerflow123
