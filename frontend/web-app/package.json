{
  "name": "web-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript-7/bin/tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --grep-invert @fullstack",
    "test:e2e:fullstack": "playwright test --grep @fullstack",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.104.0",
    "axios": "^1.20.0",
    "react": "^19.2.6",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.15.1",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@playwright/test": "^1.63.0",
    "jsdom": "^26.1.0",
    "vitest": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@~7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.1"
  }
}
